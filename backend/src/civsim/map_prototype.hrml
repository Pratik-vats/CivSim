<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CivSim World Chronicle & Map Viewer</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <style>
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.15); }
    }
    @keyframes clash {
      0% { transform: scale(0.6) rotate(-15deg); opacity: 0; }
      50% { transform: scale(1.2) rotate(10deg); opacity: 1; }
      100% { transform: scale(1) rotate(0deg); opacity: 0.9; }
    }
    .pulse-anomaly {
      animation: pulse-glow 2s infinite ease-in-out;
    }
    .skirmish-clash {
      animation: clash 0.4s ease-out;
    }
    canvas {
      image-rendering: pixelated;
    }
  </style>
</head>
<body class="bg-[var(--background,#0f172a)] text-[var(--foreground,#f8fafc)] antialiased font-sans p-4 min-h-screen flex flex-col">

  <!-- Header & Status Bar -->
  <header class="flex flex-wrap items-center justify-between pb-3 border-b border-[var(--border,#334155)] mb-3 gap-2">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <h1 class="text-xl font-bold tracking-tight">CivSim: Chronicle of the Aether World</h1>
        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--card,#1e293b)] text-[var(--muted-foreground,#94a3b8)] border border-[var(--border,#334155)]">Interactive Web Concept</span>
      </div>
      <p class="text-xs text-[var(--muted-foreground,#94a3b8)] mt-0.5">Procedural Civilization & Fantasy Evolution Visualizer</p>
    </div>

    <!-- Timeline & Playback Controls -->
    <div class="flex items-center gap-3 bg-[var(--card,#1e293b)] px-3 py-1.5 rounded-lg border border-[var(--border,#334155)]">
      <button id="btnPlayPause" class="px-3 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs transition flex items-center gap-1.5">
        <span id="playIcon">▶</span> <span id="playText">Play</span>
      </button>
      <button id="btnPrevYear" class="px-2 py-1 rounded bg-[var(--secondary,#334155)] hover:bg-[var(--accent,#475569)] text-xs">⏮ -1Y</button>
      <button id="btnNextYear" class="px-2 py-1 rounded bg-[var(--secondary,#334155)] hover:bg-[var(--accent,#475569)] text-xs">⏭ +1Y</button>

      <div class="flex items-center gap-2 pl-2 border-l border-[var(--border,#334155)]">
        <label for="timelineSlider" class="text-xs font-semibold text-amber-400">Year <span id="yearDisplay" class="font-mono text-sm">0</span></label>
        <input id="timelineSlider" type="range" min="0" max="150" value="0" class="w-36 accent-indigo-500 cursor-pointer">
      </div>

      <div class="flex items-center gap-1.5 pl-2 border-l border-[var(--border,#334155)]">
        <span class="text-xs text-[var(--muted-foreground,#94a3b8)]">Speed:</span>
        <select id="speedSelect" class="bg-[var(--background,#0f172a)] text-xs rounded px-1.5 py-0.5 border border-[var(--border,#334155)]">
          <option value="1000">1x (1s)</option>
          <option value="500" selected>2x (0.5s)</option>
          <option value="200">5x (0.2s)</option>
        </select>
      </div>
    </div>
  </header>

  <!-- Main Viewport: Map (Left 70%) + Details/Inspector (Right 30%) -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 flex-1">
    
    <!-- Map Canvas Container (3 cols) -->
    <div class="lg:col-span-3 flex flex-col bg-[var(--card,#1e293b)] rounded-xl border border-[var(--border,#334155)] p-2 relative shadow-lg">
      
      <!-- Map Overlay HUD -->
      <div class="absolute top-4 left-4 z-10 flex gap-2 pointer-events-none">
        <div class="bg-[var(--background,#0f172a)]/85 backdrop-blur-sm border border-[var(--border,#334155)] rounded px-2.5 py-1 text-xs">
          <span class="text-[var(--muted-foreground,#94a3b8)]">World Pop:</span> <span id="hudPop" class="font-bold text-emerald-400">40</span>
        </div>
        <div class="bg-[var(--background,#0f172a)]/85 backdrop-blur-sm border border-[var(--border,#334155)] rounded px-2.5 py-1 text-xs">
          <span class="text-[var(--muted-foreground,#94a3b8)]">Awakened:</span> <span id="hudAwakened" class="font-bold text-purple-400">0</span>
        </div>
        <div class="bg-[var(--background,#0f172a)]/85 backdrop-blur-sm border border-[var(--border,#334155)] rounded px-2.5 py-1 text-xs">
          <span class="text-[var(--muted-foreground,#94a3b8)]">Active Anomalies:</span> <span id="hudAnomalies" class="font-bold text-amber-400">0</span>
        </div>
        <div class="bg-[var(--background,#0f172a)]/85 backdrop-blur-sm border border-[var(--border,#334155)] rounded px-2.5 py-1 text-xs">
          <span class="text-[var(--muted-foreground,#94a3b8)]">Era:</span> <span id="hudEra" class="font-bold text-cyan-400">Mundane Foundation</span>
        </div>
      </div>

      <!-- Map Canvas -->
      <canvas id="worldCanvas" width="900" height="600" class="w-full h-full rounded-lg bg-[#141e2e] cursor-crosshair"></canvas>

      <!-- Map Legend -->
      <div class="mt-2 flex flex-wrap items-center justify-between text-xs px-2 py-1 text-[var(--muted-foreground,#94a3b8)] border-t border-[var(--border,#334155)]">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Village/Town</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> City / Megacity</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span> Aether Anomaly</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span> Skirmish / Battle</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 border border-dashed border-amber-400"></span> Trade Route</span>
        </div>
        <div>Click any settlement or anomaly to inspect details</div>
      </div>
    </div>

    <!-- Inspector & Event Log Side Panel (1 col) -->
    <div class="flex flex-col gap-3">
      
      <!-- Selected Entity Inspector -->
      <div class="bg-[var(--card,#1e293b)] rounded-xl border border-[var(--border,#334155)] p-3 flex-1 flex flex-col shadow">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--muted-foreground,#94a3b8)] mb-2 flex items-center justify-between">
          <span>Inspector</span>
          <span id="inspectBadge" class="text-[11px] font-mono normal-case px-1.5 py-0.5 rounded bg-slate-800 text-slate-300">Overview</span>
        </h3>

        <div id="inspectorContent" class="space-y-3 text-xs flex-1">
          <div class="p-2.5 rounded-lg bg-[var(--background,#0f172a)] border border-[var(--border,#334155)]">
            <h4 id="inspectTitle" class="font-bold text-sm text-indigo-300">Solitude</h4>
            <p id="inspectSubtitle" class="text-[var(--muted-foreground,#94a3b8)]">River Valley • Founded Year 0</p>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div class="bg-[var(--background,#0f172a)] p-2 rounded border border-[var(--border,#334155)]">
              <span class="text-[var(--muted-foreground,#94a3b8)] block">Tier</span>
              <span id="inspectTier" class="font-semibold text-emerald-400">Village</span>
            </div>
            <div class="bg-[var(--background,#0f172a)] p-2 rounded border border-[var(--border,#334155)]">
              <span class="text-[var(--muted-foreground,#94a3b8)] block">Population</span>
              <span id="inspectPop" class="font-semibold">20</span>
            </div>
            <div class="bg-[var(--background,#0f172a)] p-2 rounded border border-[var(--border,#334155)]">
              <span class="text-[var(--muted-foreground,#94a3b8)] block">Food Stockpile</span>
              <span id="inspectFood" class="font-semibold text-amber-300">120</span>
            </div>
            <div class="bg-[var(--background,#0f172a)] p-2 rounded border border-[var(--border,#334155)]">
              <span class="text-[var(--muted-foreground,#94a3b8)] block">Tech Level</span>
              <span id="inspectTech" class="font-semibold text-cyan-300">Level 0</span>
            </div>
          </div>

          <div class="bg-[var(--background,#0f172a)] p-2.5 rounded border border-[var(--border,#334155)] space-y-1">
            <span class="text-[var(--muted-foreground,#94a3b8)] block font-medium">Leadership & Defense</span>
            <div class="flex justify-between">
              <span>Leader:</span> <span id="inspectLeader" class="font-semibold">Eldric Riverstone</span>
            </div>
            <div class="flex justify-between">
              <span>Primary Clan:</span> <span id="inspectClan" class="text-amber-300">Riverstone Clan</span>
            </div>
            <div class="flex justify-between">
              <span>Treasury:</span> <span id="inspectTreasury" class="text-yellow-400 font-mono">45.0 Iron</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Event Ticker -->
      <div class="bg-[var(--card,#1e293b)] rounded-xl border border-[var(--border,#334155)] p-3 h-48 flex flex-col shadow">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--muted-foreground,#94a3b8)] mb-2 flex items-center justify-between">
          <span>Chronicle Feed</span>
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
        </h3>
        <div id="eventLog" class="overflow-y-auto space-y-1 font-mono text-[11px] flex-1 pr-1 text-[var(--muted-foreground,#94a3b8)]">
          <div class="text-slate-400">[Y0] World initialized. Solitude and Stormhold founded.</div>
        </div>
      </div>

    </div>
  </div>

  <script>
    // --- SIMULATION HISTORY DATA (Simulated representation of CivSim annual snapshots) ---
    const historyData = [];

    // Pre-generate 150 years of deterministic historical progression
    function buildSimulationHistory() {
      let popSolitude = 20, popStormhold = 20, popHaven = 0;
      let techSolitude = 0, techStormhold = 0;
      let tradeActive = false;
      let awakenedTotal = 0;

      for (let y = 0; y <= 150; y++) {
        const events = [];
        popSolitude += Math.floor(1 + (y * 0.15));
        popStormhold += Math.floor(1 + (y * 0.12));

        if (y === 5) {
          events.push(`Year 5: Riverstone Clan founded in Solitude.`);
        }
        if (y === 12) {
          tradeActive = true;
          events.push(`Year 12: First caravan trade route established between Solitude & Stormhold!`);
        }
        if (y === 28) {
          popHaven = 15;
          events.push(`Year 28: Settlers founded new colony 'Haven' at Verdant River!`);
        }
        if (popHaven > 0) popHaven += Math.floor(1 + (y * 0.08));

        // Year 50: The Great Mutation
        if (y === 50) {
          events.push(`⭐ Year 50: THE GREAT MUTATION! Aether veins awaken worldwide.`);
        }
        if (y >= 50) {
          awakenedTotal = Math.floor((y - 48) * 1.8);
          if (y === 51) events.push(`Year 51: First Vanguard and Elementalist awakened in Solitude!`);
          if (y === 65) events.push(`Year 65: Solitude evolved into a thriving Town (Pop: ${popSolitude})!`);
          if (y === 82) events.push(`⚡ Year 82: Rare Aether Crystal Anomaly spawned at Crystal Peak!`);
          if (y === 83) events.push(`⚔️ Year 83: Resource Skirmish fought at Crystal Peak! 2 casualties.`);
          if (y === 105) events.push(`🏰 Year 105: Stormhold upgraded to fortified City!`);
          if (y === 120) events.push(`💀 Year 120: Unclaimed Anomaly mutated into Monster Lair Pending!`);
        }

        const villages = [
          {
            name: "Solitude", x: 220, y: 440, pop: popSolitude,
            tier: popSolitude > 120 ? "City" : (popSolitude > 50 ? "Town" : "Village"),
            biome: "River Valley", tech: Math.floor(y / 25), food: 100 + y * 8,
            leader: y > 70 ? "Kaelen Riverstone (T3 Vanguard)" : "Eldric Riverstone",
            clan: "Riverstone Clan", treasury: (50 + y * 12).toFixed(1)
          },
          {
            name: "Stormhold", x: 680, y: 160, pop: popStormhold,
            tier: popStormhold > 110 ? "City" : (popStormhold > 45 ? "Town" : "Village"),
            biome: "Highland Mine", tech: Math.floor(y / 20), food: 80 + y * 6,
            leader: y > 80 ? "Varek Ironfist (T4 Warden)" : "Lord Varek",
            clan: "Iron Bastion", treasury: (80 + y * 16).toFixed(1)
          }
        ];

        if (popHaven > 0) {
          villages.push({
            name: "Haven", x: 440, y: 360, pop: popHaven,
            tier: popHaven > 50 ? "Town" : "Village",
            biome: "Forest Edge", tech: Math.floor((y - 28) / 30), food: 60 + y * 4,
            leader: "Lyra Whisperwind (T2 Seer)", clan: "Verdant Order", treasury: (30 + y * 7).toFixed(1)
          });
        }

        // Dynamic anomalies
        const anomalies = [];
        if (y >= 80 && y <= 110) {
          anomalies.push({ id: "ANOM_1", name: "Crystal Peak", x: 480, y: 220, type: "Aether Crystal", state: y > 85 ? "Controlled" : "Contested", res: 180 });
        }
        if (y >= 115) {
          anomalies.push({ id: "ANOM_2", name: "Shadow Rift", x: 320, y: 180, type: "Void Shard", state: "Monster Lair Pending", res: 90 });
        }

        // Dynamic battles
        const battles = [];
        if (y >= 82 && y <= 84) {
          battles.push({ x: 480, y: 220, desc: "Skirmish: Sunstone vs Iron Bastion" });
        }

        historyData.push({
          year: y,
          popTotal: popSolitude + popStormhold + popHaven,
          awakenedTotal: awakenedTotal,
          era: y < 50 ? "Mundane Foundation" : (y < 100 ? "Aether Awakening" : "Faction Skirmishes"),
          villages: villages,
          tradeActive: tradeActive,
          anomalies: anomalies,
          battles: battles,
          events: events
        });
      }
    }

    buildSimulationHistory();

    // --- RENDERER & INTERACTIVE LOGIC ---
    const canvas = document.getElementById('worldCanvas');
    const ctx = canvas.getContext('2d');

    let currentYear = 0;
    let isPlaying = false;
    let playInterval = null;
    let selectedEntity = null;

    function renderMap() {
      const data = historyData[currentYear];
      if (!data) return;

      // Update HUD
      document.getElementById('yearDisplay').innerText = data.year;
      document.getElementById('timelineSlider').value = data.year;
      document.getElementById('hudPop').innerText = data.popTotal;
      document.getElementById('hudAwakened').innerText = data.awakenedTotal;
      document.getElementById('hudAnomalies').innerText = data.anomalies.length;
      document.getElementById('hudEra').innerText = data.era;

      // 1. Clear background & draw procedural fantasy biome terrain
      ctx.fillStyle = '#101a2b';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Biome Regions (River, Highland, Forest)
      // River
      ctx.beginPath();
      ctx.strokeStyle = '#1e3a5f';
      ctx.lineWidth = 32;
      ctx.lineCap = 'round';
      ctx.moveTo(100, 560);
      ctx.bezierCurveTo(300, 480, 400, 380, 520, 340);
      ctx.bezierCurveTo(620, 300, 780, 280, 880, 100);
      ctx.stroke();

      // Highland mountains (top right)
      ctx.fillStyle = '#1e2433';
      ctx.beginPath();
      ctx.moveTo(560, 40);
      ctx.lineTo(760, 20);
      ctx.lineTo(880, 140);
      ctx.lineTo(740, 260);
      ctx.lineTo(600, 180);
      ctx.fill();

      // Forest greenery (center left)
      ctx.fillStyle = '#0f291e';
      ctx.beginPath();
      ctx.arc(360, 340, 90, 0, Math.PI * 2);
      ctx.fill();

      // 2. Draw Trade Routes
      if (data.tradeActive && data.villages.length >= 2) {
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = '#d97706';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(data.villages[0].x, data.villages[0].y);
        ctx.lineTo(data.villages[1].x, data.villages[1].y);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // 3. Draw Anomalies
      data.anomalies.forEach(anom => {
        ctx.save();
        ctx.shadowColor = anom.state === "Monster Lair Pending" ? "#ef4444" : "#a855f7";
        ctx.shadowBlur = 15;
        ctx.fillStyle = anom.state === "Monster Lair Pending" ? "#dc2626" : "#9333ea";
        ctx.beginPath();
        ctx.arc(anom.x, anom.y, 9, 0, Math.PI * 2);
        ctx.fill();

        // Anomaly Label
        ctx.fillStyle = "#e9d5ff";
        ctx.font = "10px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(`✨ ${anom.name} (${anom.type})`, anom.x, anom.y - 14);
        ctx.restore();
      });

      // 4. Draw Battles / Skirmishes
      data.battles.forEach(btl => {
        ctx.save();
        ctx.fillStyle = "#ef4444";
        ctx.beginPath();
        ctx.arc(btl.x, btl.y, 22, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(239, 68, 68, 0.25)";
        ctx.fill();

        ctx.font = "bold 16px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("⚔️", btl.x, btl.y + 6);
        ctx.restore();
      });

      // 5. Draw Settlements
      data.villages.forEach(v => {
        const isSelected = selectedEntity && selectedEntity.name === v.name;
        
        // Tier sizing
        let radius = 8;
        let color = "#10b981"; // green village
        if (v.tier === "Town") { radius = 13; color = "#06b6d4"; }
        if (v.tier === "City") { radius = 18; color = "#6366f1"; }

        // Selection ring
        if (isSelected) {
          ctx.strokeStyle = "#fbbf24";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(v.x, v.y, radius + 6, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Settlement icon circle
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(v.x, v.y, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Text labels
        ctx.fillStyle = "#f8fafc";
        ctx.font = "bold 12px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(v.name, v.x, v.y + radius + 14);

        ctx.fillStyle = "#94a3b8";
        ctx.font = "10px sans-serif";
        ctx.fillText(`${v.tier} (Pop: ${v.pop})`, v.x, v.y + radius + 26);
      });

      // 6. Log Events to Ticker
      if (data.events && data.events.length > 0) {
        const log = document.getElementById('eventLog');
        data.events.forEach(ev => {
          const div = document.createElement('div');
          div.className = ev.includes('⭐') || ev.includes('⚡') ? "text-amber-300 font-semibold" : (ev.includes('⚔️') ? "text-red-400 font-semibold" : "text-slate-300");
          div.innerText = ev;
          log.prepend(div);
        });
      }
    }

    // Entity Inspector Update
    function updateInspector(village) {
      if (!village) return;
      selectedEntity = village;
      document.getElementById('inspectTitle').innerText = village.name;
      document.getElementById('inspectSubtitle').innerText = `${village.biome} • Coordinates (${village.x}, ${village.y})`;
      document.getElementById('inspectTier').innerText = village.tier;
      document.getElementById('inspectPop').innerText = village.pop;
      document.getElementById('inspectFood').innerText = village.food;
      document.getElementById('inspectTech').innerText = `Level ${village.tech}`;
      document.getElementById('inspectLeader').innerText = village.leader;
      document.getElementById('inspectClan').innerText = village.clan;
      document.getElementById('inspectTreasury').innerText = `${village.treasury} Iron`;
      renderMap();
    }

    // Click Detection
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const data = historyData[currentYear];
      if (!data) return;

      for (const v of data.villages) {
        const dist = Math.hypot(v.x - clickX, v.y - clickY);
        if (dist <= 25) {
          updateInspector(v);
          return;
        }
      }
    });

    // Playback Controls
    function setYear(y) {
      currentYear = Math.max(0, Math.min(150, y));
      renderMap();
    }

    function togglePlay() {
      isPlaying = !isPlaying;
      document.getElementById('playText').innerText = isPlaying ? "Pause" : "Play";
      document.getElementById('playIcon').innerText = isPlaying ? "⏸" : "▶";

      if (isPlaying) {
        const speed = parseInt(document.getElementById('speedSelect').value);
        playInterval = setInterval(() => {
          if (currentYear >= 150) {
            togglePlay();
            return;
          }
          setYear(currentYear + 1);
        }, speed);
      } else {
        clearInterval(playInterval);
      }
    }

    document.getElementById('btnPlayPause').addEventListener('click', togglePlay);
    document.getElementById('timelineSlider').addEventListener('input', (e) => setYear(parseInt(e.target.value)));
    document.getElementById('btnNextYear').addEventListener('click', () => setYear(currentYear + 1));
    document.getElementById('btnPrevYear').addEventListener('click', () => setYear(currentYear - 1));
    document.getElementById('speedSelect').addEventListener('change', () => {
      if (isPlaying) {
        togglePlay();
        togglePlay();
      }
    });

    // Initial render
    renderMap();
    updateInspector(historyData[0].villages[0]);
  </script>
</body>
</html>