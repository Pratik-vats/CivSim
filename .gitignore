build/
**/build/
dist/
**/dist/
target/
**/target/
out/
**/out/
!**/src/main/**/out/
*.class

# Compile source listings and temporary compiler files
compile_sources.txt
**/compile_sources.txt
*.sources.txt

### Java Crash Dumps & Profiling ###
hs_err_pid*
replay_pid*
*.hprof

### Dependencies (Preserve committed JARs in backend/lib/) ###
# Note: Spring Boot and runtime jars in backend/lib/ must NOT be ignored
!/backend/lib/
!/src/lib/
!/lib/
!*.jar

